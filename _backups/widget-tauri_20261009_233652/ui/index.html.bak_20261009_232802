<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MYRA</title>
    <link rel="stylesheet" href="style.css">
</head>
<body data-theme="dark" data-compact="off">

    <button id="btn-settings" title="Configuracoes">&#9881;</button>

    <!-- Popover de configuracoes -->
    <div id="settings-popover" data-tauri-drag-region>
        <div class="pop-header" data-tauri-drag-region>
            <span class="drag-handle" data-tauri-drag-region>&#8942;&#8942;</span>
            <span class="pop-label" data-tauri-drag-region>MYRA</span>
            <button id="btn-close-pop" title="Fechar popover">&#10005;</button>
        </div>

        <div class="pop-section">
            <div class="pop-title">Aparencia</div>
            <div class="pop-row">
                <button class="pop-btn" id="btn-theme" title="Tema">&#127769; Tema</button>
                <button class="pop-btn" id="btn-compact" title="Compacto">&#9723; Compacto</button>
            </div>
            <div class="pop-row">
                <label class="pop-color-label">
                    Cor
                    <input type="color" id="mascot-color" value="#6366f1">
                </label>
            </div>
        </div>

        <div class="pop-section">
            <div class="pop-title">Comportamento</div>
            <div class="pop-row">
                <button class="pop-btn" id="btn-sound" title="Som">&#128266; Som</button>
                <button class="pop-btn" id="btn-dnd" title="Nao perturbe">&#128277; DND</button>
            </div>
            <div class="pop-row">
                <button class="pop-btn" id="btn-top" title="Sempre no topo">&#128204; Fixar</button>
            </div>
        </div>

        <div class="pop-section">
            <div class="pop-title">Opacidade</div>
            <input type="range" id="opacity" min="30" max="100" value="95">
        </div>

        <div class="pop-section pop-section-danger">
            <button class="pop-btn danger" id="btn-quit" title="Fechar widget">&#10005; Fechar widget</button>
        </div>
    </div>

    <canvas id="particles"></canvas>
    <div id="confetti-layer"></div>

    <div id="island" class="island idle">

        <div class="view view-idle active">
            <div class="mascot idle" id="mascot">
                <div class="eye left"></div>
                <div class="eye right"></div>
                <div class="mouth"></div>
                <div class="zzz">zZz</div>
                <div class="speech" id="speech"></div>
            </div>
            <span class="label">MYRA</span>
            <span class="status-dot"></span>
        </div>

        <div class="view view-running">
            <div class="header">
                <div class="mascot running" id="mascot-running">
                    <div class="eye left"></div>
                    <div class="eye right"></div>
                    <div class="mouth"></div>
                    <div class="speech"></div>
                </div>
                <span class="label">MYRA</span>
                <button class="btn-close" onclick="closeWidget()" title="Fechar">&times;</button>
            </div>
            <div class="content">
                <div class="state-row">
                    <span class="state-icon spinning">&#9881;&#65039;</span>
                    <span class="state-text">Executando...</span>
                </div>
                <div class="tool-row">
                    <span class="tool-name" id="tool-name">&mdash;</span>
                </div>
                <div class="quick-actions" id="quick-actions-running">
                    <button class="qa" onclick="cancelTask()">Cancelar</button>
                </div>
            </div>
            <div class="footer">
                <span class="meta" id="meta-tempo">&#9201; 0s</span>
                <span class="meta" id="meta-passos">&#9881; 0 passos</span>
                <button class="btn btn-cancel" onclick="cancelTask()">Cancelar</button>
            </div>
        </div>

        <div class="view view-done">
            <div class="header">
                <div class="mascot done" id="mascot-done">
                    <div class="eye left"></div>
                    <div class="eye right"></div>
                    <div class="mouth"></div>
                    <div class="speech"></div>
                </div>
                <span class="label">MYRA</span>
                <button class="btn-close" onclick="closeWidget()" title="Fechar">&times;</button>
            </div>
            <div class="content">
                <div class="state-row">
                    <span class="state-icon">&#9989;</span>
                    <span class="state-text">Concluido</span>
                </div>
                <div class="result-text" id="result-text">(sem resultado)</div>
                <div class="quick-actions">
                    <button class="qa" onclick="copyResult()" title="Copiar">&#128203; Copiar</button>
                    <button class="qa" onclick="repeatTask()" title="Repetir">&#128257; Repetir</button>
                </div>
            </div>
            <div class="footer">
                <button class="btn btn-ok" onclick="resetWidget()">OK</button>
            </div>
        </div>

        <div class="view view-error">
            <div class="header">
                <div class="mascot error" id="mascot-error">
                    <div class="eye left"></div>
                    <div class="eye right"></div>
                    <div class="mouth"></div>
                    <div class="speech"></div>
                </div>
                <span class="label">MYRA</span>
                <button class="btn-close" onclick="closeWidget()" title="Fechar">&times;</button>
            </div>
            <div class="content">
                <div class="state-row">
                    <span class="state-icon">&#9888;&#65039;</span>
                    <span class="state-text">Erro</span>
                </div>
                <div class="result-text error-text" id="error-text">(sem mensagem)</div>
            </div>
            <div class="footer">
                <button class="btn btn-ok" onclick="resetWidget()">Fechar</button>
            </div>
        </div>

    </div>

    <div id="gpu-badge" title="VRAM da GPU">
        <span id="gpu-icon">&#127918;</span>
        <span id="gpu-text">0/4096 MB</span>
        <div id="gpu-bar"><div id="gpu-fill"></div></div>
    </div>

    <script src="main.js"></script>
    <script src="features.js"></script>
</body>
</html>