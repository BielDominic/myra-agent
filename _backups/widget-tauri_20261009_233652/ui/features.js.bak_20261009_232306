// ============================================================
// MYRA Widget - Pacote Bonito
// Itens: 17 (VRAM), 22 (tema), 23 (cor), 24 (compacto),
//        25 (confete), 26 (cursor), 27 (sons), 28 (particulas)
// ============================================================

const _invoke = window.__TAURI__.core.invoke;

// ---------- Estado persistido ----------
const state = {
    theme:   localStorage.getItem('myra-theme')   || 'dark',
    sound:   localStorage.getItem('myra-sound')   !== 'off',
    compact: localStorage.getItem('myra-compact') === 'on',
    color:   localStorage.getItem('myra-color')   || '#6366f1',
};

// ---------- [22] Tema ----------
function applyTheme() {
    document.body.dataset.theme = state.theme;
    const btn = document.getElementById('btn-theme');
    if (btn) btn.textContent = state.theme === 'dark' ? '\u{1F319}' : '\u2600\uFE0F';
}

// ---------- [23] Cor do mascote ----------
function applyColor() {
    document.documentElement.style.setProperty('--myra-accent', state.color);
    // Deriva um tom mais claro pro gradient
    const light = shadeHex(state.color, 20);
    document.documentElement.style.setProperty('--myra-accent-2', light);
    const input = document.getElementById('mascot-color');
    if (input) input.value = state.color;
}

function shadeHex(hex, pct) {
    const n = parseInt(hex.replace('#',''), 16);
    const r = Math.min(255, ((n >> 16) & 255) + pct);
    const g = Math.min(255, ((n >> 8)  & 255) + pct);
    const b = Math.min(255, (n & 255)        + pct);
    return '#' + [r,g,b].map(v => v.toString(16).padStart(2,'0')).join('');
}

// ---------- [24] Modo compacto ----------
function applyCompact() {
    document.body.dataset.compact = state.compact ? 'on' : 'off';
    const btn = document.getElementById('btn-compact');
    if (btn) btn.style.color = state.compact ? 'var(--myra-accent)' : '';
    // Reaplica tamanho se estiver idle
    if (window.__myraResize) window.__myraResize();
}

// ---------- [27] Sons (WebAudio) ----------
let audioCtx = null;
function playSound(kind) {
    if (!state.sound) return;
    try {
        if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        const now = audioCtx.currentTime;
        const notes = {
            pop:    [{ f: 660, t: 0.00, d: 0.10 }],
            chime:  [{ f: 523, t: 0.00, d: 0.15 }, { f: 784, t: 0.12, d: 0.20 }],
            error:  [{ f: 220, t: 0.00, d: 0.20 }, { f: 165, t: 0.15, d: 0.25 }],
        }[kind] || [];
        notes.forEach(n => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.value = n.f;
            gain.gain.setValueAtTime(0.0001, now + n.t);
            gain.gain.exponentialRampToValueAtTime(0.15, now + n.t + 0.01);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + n.t + n.d);
            osc.connect(gain); gain.connect(audioCtx.destination);
            osc.start(now + n.t);
            osc.stop(now + n.t + n.d + 0.02);
        });
    } catch (e) { /* silencio */ }
}

// ---------- [25] Confete ----------
function fireConfetti() {
    const layer = document.getElementById('confetti-layer');
    if (!layer) return;
    const colors = ['#6366f1','#8b5cf6','#10b981','#f59e0b','#ef4444','#06b6d4'];
    for (let i = 0; i < 40; i++) {
        const p = document.createElement('div');
        p.className = 'confetti-piece';
        p.style.left = Math.random() * 100 + '%';
        p.style.top  = '-10px';
        p.style.background = colors[i % colors.length];
        p.style.animationDuration = (1.2 + Math.random() * 1.2) + 's';
        p.style.animationDelay = (Math.random() * 0.3) + 's';
        p.style.transform = 'rotate(' + (Math.random()*360) + 'deg)';
        layer.appendChild(p);
        setTimeout(() => p.remove(), 3000);
    }
}

// ---------- [28] Particulas ----------
const particles = {
    canvas: null, ctx: null, list: [],
    init() {
        this.canvas = document.getElementById('particles');
        if (!this.canvas) return;
        this.ctx = this.canvas.getContext('2d');
        this.resize();
        window.addEventListener('resize', () => this.resize());
        this.loop();
    },
    resize() {
        if (!this.canvas) return;
        this.canvas.width  = window.innerWidth;
        this.canvas.height = window.innerHeight;
    },
    burst() {
        const w = window.innerWidth, h = window.innerHeight;
        const cx = w/2, cy = h/2;
        for (let i = 0; i < 30; i++) {
            const a = (Math.PI * 2 * i) / 30;
            const sp = 1.5 + Math.random() * 2.5;
            this.list.push({
                x: cx, y: cy,
                vx: Math.cos(a) * sp,
                vy: Math.sin(a) * sp,
                life: 1.0,
                color: state.color,
            });
        }
    },
    loop() {
        if (!this.ctx) return;
        const { ctx, canvas } = this;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (let i = this.list.length - 1; i >= 0; i--) {
            const p = this.list[i];
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.08;
            p.life -= 0.02;
            if (p.life <= 0) { this.list.splice(i, 1); continue; }
            ctx.globalAlpha = p.life;
            ctx.fillStyle = p.color;
            ctx.beginPath();
            ctx.arc(p.x, p.y, 2.5, 0, Math.PI * 2);
            ctx.fill();
        }
        ctx.globalAlpha = 1;
        requestAnimationFrame(() => this.loop());
    }
};

// ---------- [17] VRAM GPU ----------
async function pollGpu() {
    try {
        const info = await _invoke('get_gpu_info');
        if (!info || !info.ok) return;
        const txt = document.getElementById('gpu-text');
        const fill = document.getElementById('gpu-fill');
        if (txt)  txt.textContent = info.used + '/' + info.total + ' MB';
        if (fill) fill.style.width = Math.min(100, (info.used / info.total) * 100) + '%';
    } catch (e) { /* silencio */ }
}

// ---------- Hooks do main.js ----------
window.myraOnDone = function() {
    playSound('chime');
    fireConfetti();
    particles.burst();
};
window.myraOnError = function() {
    playSound('error');
};

// ---------- Bind dos botoes do chrome ----------
function bindChrome() {
    document.getElementById('btn-theme')?.addEventListener('click', (e) => {
        e.stopPropagation();
        state.theme = state.theme === 'dark' ? 'light' : 'dark';
        localStorage.setItem('myra-theme', state.theme);
        applyTheme();
        playSound('pop');
    });

    document.getElementById('btn-sound')?.addEventListener('click', (e) => {
        e.stopPropagation();
        state.sound = !state.sound;
        localStorage.setItem('myra-sound', state.sound ? 'on' : 'off');
        const b = document.getElementById('btn-sound');
        if (b) b.textContent = state.sound ? '\u{1F50A}' : '\u{1F507}';
        if (state.sound) playSound('pop');
    });

    document.getElementById('btn-compact')?.addEventListener('click', (e) => {
        e.stopPropagation();
        state.compact = !state.compact;
        localStorage.setItem('myra-compact', state.compact ? 'on' : 'off');
        applyCompact();
        playSound('pop');
    });

    document.getElementById('mascot-color')?.addEventListener('input', (e) => {
        state.color = e.target.value;
        localStorage.setItem('myra-color', state.color);
        applyColor();
    });
}

// ---------- Init ----------
window.addEventListener('DOMContentLoaded', () => {
    applyTheme();
    applyColor();
    applyCompact();

    // Atualiza icone do botao som
    const sb = document.getElementById('btn-sound');
    if (sb) sb.textContent = state.sound ? '\u{1F50A}' : '\u{1F507}';

    bindChrome();
    particles.init();

    // Polling VRAM a cada 5s
    pollGpu();
    setInterval(pollGpu, 5000);
});

// Exposto pro main.js
window.__myraResize = () => {
    const s = document.getElementById('island');
    if (!s) return;
    const state = s.classList.contains('idle') ? 'idle' : 'card';
    const compact = document.body.dataset.compact === 'on';
    const w = state === 'idle' ? (compact ? 60 : 200) : 440;
    const h = state === 'idle' ? 44 : 340;
    _invoke('resize_window', { width: w, height: h }).catch(() => {});
};