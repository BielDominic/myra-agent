/* ============================================================
   MYRA Widget — Tauri (com mascote expressivo)
   ============================================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    background: transparent;
    overflow: hidden;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Inter, system-ui, sans-serif;
    user-select: none;
    -webkit-user-select: none;
    color: #e2e8f0;
    cursor: default;
}

body {
    display: flex;
    align-items: center;
    justify-content: center;
}

/* ============================================================
   ISLAND
   ============================================================ */

.island {
    background: rgba(15, 15, 25, 0.95);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 22px;
    box-shadow:
        inset 0 1px 0 rgba(255, 255, 255, 0.05),
        inset 0 0 24px rgba(99, 102, 241, 0.08);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    overflow: hidden;
    transition: width 300ms cubic-bezier(0.34, 1.56, 0.64, 1),
                height 300ms cubic-bezier(0.34, 1.56, 0.64, 1);
}

.island.idle { width: 200px; height: 44px; }
.island.running, .island.done, .island.error { width: 440px; height: 340px; }
.island button { cursor: pointer; }

/* ============================================================
   VIEWS
   ============================================================ */

.view { width: 100%; height: 100%; display: none; flex-direction: column; }
.view.active { display: flex; }

.view-idle {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 18px;
}

.view-idle .label { font-size: 14px; font-weight: 600; letter-spacing: 0.5px; }

.view-idle .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #6366f1;
    box-shadow: 0 0 8px rgba(99, 102, 241, 0.8);
    animation: pulse-dot 2s ease-in-out infinite;
}

@keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(0.9); }
}

/* ============================================================
   MASCOTE
   ============================================================ */

.mascot {
    width: 32px;
    height: 32px;
    min-width: 32px;
    border-radius: 50%;
    background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    box-shadow: 0 0 12px rgba(99, 102, 241, 0.4);
    position: relative;
    transition: all 300ms ease;
    cursor: pointer;
}

.mascot .eye {
    width: 6px;
    height: 6px;
    background: white;
    border-radius: 50%;
    transition: transform 80ms ease, width 150ms ease, height 150ms ease;
    transform: translate(0, 0);
}

.mascot .mouth {
    position: absolute;
    bottom: 6px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-radius: 0 0 8px 8px;
    background: white;
    transition: all 200ms ease;
    opacity: 0;
}

/* Piscar */
.mascot.blink .eye {
    height: 1px;
    border-radius: 1px;
}

/* Expressões por estado */

.mascot.idle { animation: breathe 3s ease-in-out infinite; }

@keyframes breathe {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.05); }
}

.mascot.running {
    background: linear-gradient(135deg, #f59e0b 0%, #ef4444 100%);
    box-shadow: 0 0 16px rgba(245, 158, 11, 0.6);
    animation: pulse-running 1.5s ease-in-out infinite;
}

@keyframes pulse-running {
    0%, 100% { transform: scale(1) rotate(0deg); }
    50% { transform: scale(1.1) rotate(5deg); }
}

.mascot.running .eye {
    width: 7px;
    height: 7px;
}

.mascot.done {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    box-shadow: 0 0 16px rgba(16, 185, 129, 0.6);
    animation: pop-done 0.6s ease-out;
}

@keyframes pop-done {
    0% { transform: scale(1); }
    40% { transform: scale(1.3); }
    70% { transform: scale(0.95); }
    100% { transform: scale(1); }
}

.mascot.done .eye {
    height: 2px;
    width: 8px;
    border-radius: 2px;
    transform: translateY(-1px);
}

.mascot.done .mouth {
    opacity: 1;
    width: 10px;
    height: 5px;
    background: white;
}

.mascot.error {
    background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
    box-shadow: 0 0 16px rgba(239, 68, 68, 0.6);
    animation: shake-error 0.4s ease-in-out;
}

@keyframes shake-error {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-3px); }
    75% { transform: translateX(3px); }
}

.mascot.error .eye {
    height: 2px;
    width: 7px;
    border-radius: 2px;
}

.mascot.error .mouth {
    opacity: 1;
    width: 8px;
    height: 4px;
    background: white;
    border-radius: 8px 8px 0 0;
    bottom: 5px;
}

/* Hover no mascote */
.mascot:hover {
    transform: scale(1.15);
    box-shadow: 0 0 20px rgba(99, 102, 241, 0.8);
}

.mascot:hover .eye {
    width: 7px;
    height: 7px;
}

/* Speech bubble */
.speech {
    position: absolute;
    top: -28px;
    left: 50%;
    transform: translateX(-50%) scale(0);
    background: rgba(99, 102, 241, 0.95);
    color: white;
    font-size: 10px;
    font-weight: 600;
    padding: 4px 8px;
    border-radius: 8px;
    white-space: nowrap;
    opacity: 0;
    transition: all 200ms ease;
    pointer-events: none;
    z-index: 10;
}

.speech::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 4px solid rgba(99, 102, 241, 0.95);
}

.speech.show {
    opacity: 1;
    transform: translateX(-50%) scale(1);
}

/* ============================================================
   HEADER / CONTENT / FOOTER
   ============================================================ */

.header {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-bottom: 1px solid rgba(99, 102, 241, 0.15);
    flex-shrink: 0;
}

.header .label { font-size: 14px; font-weight: 600; flex: 1; }

.btn-close {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 20px;
    cursor: pointer;
    padding: 4px 8px;
    border-radius: 6px;
}

.btn-close:hover { background: rgba(239, 68, 68, 0.2); color: #ef4444; }

.content {
    flex: 1;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
    min-height: 0;
}

.state-row { display: flex; align-items: center; gap: 8px; }
.state-icon { font-size: 16px; }
.state-icon.spinning { animation: spin 1.5s linear infinite; }

@keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

.state-text { font-size: 13px; font-weight: 500; }

.tool-row { display: flex; align-items: center; gap: 8px; padding-left: 24px; }

.tool-name {
    font-size: 12px;
    font-family: "Consolas", monospace;
    color: #a5b4fc;
    background: rgba(99, 102, 241, 0.1);
    padding: 3px 8px;
    border-radius: 6px;
    border: 1px solid rgba(99, 102, 241, 0.2);
}

.result-text {
    font-size: 13px;
    line-height: 1.5;
    color: #cbd5e1;
    background: rgba(0, 0, 0, 0.2);
    padding: 10px 12px;
    border-radius: 8px;
    border-left: 3px solid #10b981;
    max-height: 120px;
    overflow-y: auto;
    word-wrap: break-word;
}

.result-text.error-text { border-left-color: #ef4444; color: #fca5a5; }

.footer {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 16px;
    border-top: 1px solid rgba(99, 102, 241, 0.15);
    background: rgba(0, 0, 0, 0.15);
    flex-shrink: 0;
}

.meta { font-size: 11px; color: #94a3b8; font-weight: 500; }

.btn {
    padding: 5px 14px;
    border-radius: 8px;
    border: none;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    margin-left: auto;
}

.btn-cancel {
    background: rgba(239, 68, 68, 0.15);
    color: #fca5a5;
    border: 1px solid rgba(239, 68, 68, 0.3);
}

.btn-cancel:hover { background: rgba(239, 68, 68, 0.3); color: #ffffff; }

.btn-ok {
    background: rgba(99, 102, 241, 0.2);
    color: #a5b4fc;
    border: 1px solid rgba(99, 102, 241, 0.3);
}

.btn-ok:hover { background: rgba(99, 102, 241, 0.4); color: #ffffff; }

/* ============================================================
   CHROME
   ============================================================ */

#chrome {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 16px;
    background: rgba(15, 15, 25, 0.9);
    border-bottom: 1px solid rgba(99, 102, 241, 0.3);
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 6px;
    font-size: 9px;
    color: #94a3b8;
    z-index: 9999;
    cursor: move;
    user-select: none;
    opacity: 0;
    transition: opacity 150ms ease;
}

body:hover #chrome { opacity: 0.9; }

#chrome .drag-handle { font-size: 10px; color: #6366f1; }
#chrome .chrome-label { font-size: 9px; font-weight: 600; color: #a5b4fc; }
#chrome input[type="range"] { width: 45px; height: 3px; cursor: pointer; margin-left: auto; }
#chrome #btn-close {
    background: transparent;
    border: none;
    color: #94a3b8;
    font-size: 11px;
    cursor: pointer;
    padding: 0 4px;
}
#chrome #btn-close:hover { color: #ef4444; }