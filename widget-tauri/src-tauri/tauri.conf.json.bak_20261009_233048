{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MYRA",
  "version": "0.1.0",
  "identifier": "com.myra.widget",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MYRA",
        "width": 200,
        "height": 44,
        "minWidth": 200,
        "minHeight": 44,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
