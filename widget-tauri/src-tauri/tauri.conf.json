{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MYRA",
  "version": "0.1.0",
  "identifier": "com.myra.widget",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MYRA",
        "width": 220,
        "height": 96,
        "minWidth": 60,
        "minHeight": 96,
        "transparent": true,
        "decorations": false,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": false,
        "resizable": false,
        "minimizable": false,
        "maximizable": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}