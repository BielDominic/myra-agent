"""
MYRA Widget — Island flutuante com altura DINAMICA via Win32.
Contorna o bug do js_api do pywebview 5.x/6.x no Windows.
Transparencia real via WS_EX_LAYERED + LWA_COLORKEY.
"""
import sys
import json
import time
import urllib.request
import threading
import ctypes
from ctypes import wintypes
import webview
from pathlib import Path

AGENT_URL = "http://127.0.0.1:8000"

# ============================================================
# DIMENSOES E POSICAO
# ============================================================

IDLE_WIDTH = 200
IDLE_HEIGHT = 44

CARD_WIDTH = 440
CARD_HEIGHT = 340

TOP_MARGIN = 40
OFFSET_X = -155  # 0 = centro, negativo = esquerda, positivo = direita

WIDGET_DIR = Path(__file__).parent.resolve()
INDEX_HTML = WIDGET_DIR / "index.html"

# ============================================================
# TRANSPARENCIA (chroma key)
# ============================================================
# Cor do fundo do body do HTML — em formato Win32 0x00BBGGRR
# #0a0a15 em RGB  ->  R=0x15, G=0x0a, B=0x0a  ->  Win32 = 0x000a0a15
BACKGROUND_COLOR_HEX = "#0a0a15"
BACKGROUND_COLOR_WIN32 = 0x000a0a15

# Constantes Win32
GWL_EXSTYLE = -20
WS_EX_LAYERED = 0x00080000
LWA_COLORKEY = 0x00000001


def _aplicar_transparencia(hwnd):
    """
    Aplica transparencia por cor (chroma key) na janela.
    Tudo que for EXATAMENTE BACKGROUND_COLOR_WIN32 fica invisivel.

    Deve ser chamado UMA vez, logo apos o HWND existir.
    """
    if not hwnd:
        print("[TRANSP] HWND invalido, transparencia nao aplicada.")
        return False

    user32 = ctypes.windll.user32

    # Pega o estilo estendido atual
    ex_style = user32.GetWindowLongW(hwnd, GWL_EXSTYLE)

    # Adiciona WS_EX_LAYERED (se ainda nao tiver)
    if not (ex_style & WS_EX_LAYERED):
        user32.SetWindowLongW(hwnd, GWL_EXSTYLE, ex_style | WS_EX_LAYERED)

    # Aplica a cor-chave (tudo que for essa cor fica transparente)
    ok = user32.SetLayeredWindowAttributes(
        hwnd,
        BACKGROUND_COLOR_WIN32,  # cor-chave
        0,                        # alpha (ignorado quando so LWA_COLORKEY)
        LWA_COLORKEY,
    )

    if ok:
        print(f"[TRANSP] chroma key aplicado em {BACKGROUND_COLOR_HEX}")
    else:
        print("[TRANSP] SetLayeredWindowAttributes falhou")

    return bool(ok)


# ============================================================
# WIN32 — acha a janela e redimensiona
# ============================================================

def get_hwnd_from_title(title="MYRA"):
    """
    Pega o HWND da janela do widget.
    Procura por titulo EXATO primeiro (evita pegar Chrome/Edge com 'MYRA' no titulo).
    """
    user32 = ctypes.windll.user32

    # PRIMEIRO: busca exata (o widget tem titulo == "MYRA")
    hwnd = user32.FindWindowW(None, title)
    if hwnd:
        return hwnd

    # FALLBACK: busca por titulo EXATO via EnumWindows
    found = []

    @ctypes.WINFUNCTYPE(wintypes.BOOL, wintypes.HWND, wintypes.LPARAM)
    def enum_proc(hwnd, lparam):
        length = user32.GetWindowTextLengthW(hwnd)
        if length > 0:
            buf = ctypes.create_unicode_buffer(length + 1)
            user32.GetWindowTextW(hwnd, buf, length + 1)
            texto = buf.value.strip()
            # So aceita se for EXATAMENTE "MYRA" (igual, sem sufixos)
            if texto == title:
                found.append(hwnd)
        return True

    user32.EnumWindows(enum_proc, 0)

    if found:
        return found[0]
    return 0


def resize_window_win32(hwnd, width, height):
    """Redimensiona E recentraliza a janela via Win32 API."""
    user32 = ctypes.windll.user32

    # Calcula nova posicao X pra manter centralizado
    screen_width, _ = get_screen_size()
    centro = (screen_width - width) // 2
    x_pos = centro + OFFSET_X

    # SWP_NOZORDER = 0x0004 (mantém z-order, move + redimensiona)
    user32.SetWindowPos(hwnd, 0, x_pos, TOP_MARGIN, width, height, 0x0004)


def _preparar_janela(hwnd):
    """
    Aplica transparencia + resize inicial.
    Chamado uma vez, logo apos o HWND ser encontrado.
    """
    _aplicar_transparencia(hwnd)
    resize_window_win32(hwnd, IDLE_WIDTH, IDLE_HEIGHT)
    print(f"[MONITOR] resize inicial: pilula {IDLE_WIDTH}x{IDLE_HEIGHT}")


# ============================================================
# MONITOR DE STATUS (polling no Python, sem js_api)
# ============================================================

class StatusMonitor(threading.Thread):
    """Thread que polla o /task_status e redimensiona a janela."""

    def __init__(self):
        super().__init__(daemon=True)
        self._stop = False
        self._last_state = None
        self._hwnd = None

    def stop(self):
        self._stop = True

    def run(self):
        # Espera o hwnd ficar disponivel (ate 15s)
        for _ in range(150):
            if self._stop:
                return
            self._hwnd = get_hwnd_from_title("MYRA")
            if self._hwnd:
                break
            time.sleep(0.1)

        if not self._hwnd:
            print("[MONITOR] nao achei a janela MYRA pra redimensionar")
            return

        print(f"[MONITOR] HWND encontrado: {self._hwnd}")

        # Aplica transparencia + resize inicial
        _preparar_janela(self._hwnd)

        while not self._stop:
            try:
                req = urllib.request.Request(f"{AGENT_URL}/task_status", method="GET")
                with urllib.request.urlopen(req, timeout=3) as r:
                    status = json.loads(r.read().decode("utf-8"))

                state = status.get("state", "idle")

                if state != self._last_state:
                    print(f"[MONITOR] state: {self._last_state} -> {state}")
                    self._last_state = state

                    if state == "idle":
                        resize_window_win32(self._hwnd, IDLE_WIDTH, IDLE_HEIGHT)
                    else:
                        resize_window_win32(self._hwnd, CARD_WIDTH, CARD_HEIGHT)

            except Exception:
                # Agent offline — silencio
                pass

            time.sleep(0.5)


# ============================================================
# DPI + POSICAO
# ============================================================

def enable_dpi_awareness():
    try:
        try:
            ctypes.windll.shcore.SetProcessDpiAwareness(2)
        except Exception:
            try:
                ctypes.windll.user32.SetProcessDPIAware()
            except Exception:
                pass
    except Exception:
        pass


def get_screen_size():
    try:
        user32 = ctypes.windll.user32
        return user32.GetSystemMetrics(0), user32.GetSystemMetrics(1)
    except Exception:
        return 1920, 1080


def get_center_position(width):
    screen_width, _ = get_screen_size()
    centro = (screen_width - width) // 2
    return centro + OFFSET_X


# ============================================================
# MAIN
# ============================================================

def main():
    print("=== MYRA Widget ===")
    print(f"HTML: {INDEX_HTML}")

    if not INDEX_HTML.exists():
        print(f"ERRO: {INDEX_HTML} nao existe!")
        sys.exit(1)

    enable_dpi_awareness()

    screen_width, screen_height = get_screen_size()
    x_pos = get_center_position(IDLE_WIDTH)

    print(f"Tela: {screen_width}x{screen_height}")
    print(f"Janela inicial: {IDLE_WIDTH}x{IDLE_HEIGHT} em ({x_pos}, {TOP_MARGIN})")

    # Comeca como pilula
    window = webview.create_window(
        title="MYRA",
        url=str(INDEX_HTML),
        width=IDLE_WIDTH,
        height=IDLE_HEIGHT,
        x=x_pos,
        y=TOP_MARGIN,
        resizable=False,
        frameless=True,
        easy_drag=True,
        background_color=BACKGROUND_COLOR_HEX,
    )

    # Monitor de status (polling no Python)
    monitor = StatusMonitor()
    monitor.start()

    try:
        webview.start(debug=False)
    finally:
        monitor.stop()
        print("Widget fechado.")


if __name__ == "__main__":
    main()